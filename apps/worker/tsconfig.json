{
  "compilerOptions": {
    "module": "NodeNext", "moduleResolution": "NodeNext", "target": "ES2022",
    "rootDir": "src", "outDir": "dist", "types": ["node"],
    "strict": true, "noImplicitReturns": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true, "skipLibCheck": true,
    "declaration": true, "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"], "exclude": ["dist", "dist-test", "node_modules"]
}
