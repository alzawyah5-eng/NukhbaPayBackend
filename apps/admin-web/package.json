{
  "name": "@nukhbapay/admin-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./portal": { "types": "./dist/portal.d.ts", "import": "./dist/portal.js" },
    "./auth0": { "types": "./dist/auth0.d.ts", "import": "./dist/auth0.js" }
  },
  "description": "Local HTTPS staff BFF; real login and session activation remain disabled.",
  "engines": { "node": ">=24 <25" },
