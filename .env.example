# Development placeholders only. Generate your own local passwords.
NUKHBAPAY_ENV=local
NUKHBAPAY_ENVIRONMENT=development
NODE_ENV=development
NUKHBAPAY_PROVIDER_MODE=mock
NUKHBAPAY_AI_MODE=rules_only
NUKHBAPAY_CATALOG_TIMEZONE=Asia/Dubai
POSTGRES_PASSWORD=replace_with_a_local_random_password
NUKHBAPAY_DB_MIGRATION_PASSWORD=replace_with_a_different_local_random_password
NUKHBAPAY_DB_RUNTIME_PASSWORD=replace_with_another_local_random_password
NUKHBAPAY_DB_IMPORTER_PASSWORD=replace_with_a_separate_local_random_password
DB_MIGRATION_URL=postgresql://nukhabapay_migrator:replace_with_percent_encoded_password@127.0.0.1:5432/nukhabapay_dev
DB_RUNTIME_URL=postgresql://nukhabapay_runtime:replace_with_percent_encoded_password@127.0.0.1:5432/nukhabapay_dev
DB_RUNTIME_ROLE=nukhabapay_runtime
DB_IMPORT_ROLE=nukhabapay_importer
DB_IDENTITY_READER_ROLE=nukhabapay_identity_reader
DB_IDENTITY_READER_URL=postgresql://nukhabapay_identity_reader:replace_with_a_separate_local_random_password@127.0.0.1:5432/nukhabapay_dev
DB_IDENTITY_WRITER_ROLE=nukhabapay_identity_writer
DB_IDENTITY_WRITER_URL=postgresql://nukhabapay_identity_writer:replace_with_another_separate_local_random_password@127.0.0.1:5432/nukhabapay_dev
DB_IMPORT_URL=postgresql://nukhabapay_importer:replace_with_a_local_importer_password@127.0.0.1:5432/nukhabapay_dev
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=3000
DB_QUERY_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=5000
# Required only for the destructive, disposable PostgreSQL integration harness; never use this identity for persistent deployment or runtime.
DB_TEST_ADMIN_URL=postgresql://postgres:replace_with_percent_encoded_disposable_admin_password@127.0.0.1:5432/postgres
REDIS_PASSWORD=replace_with_a_different_local_random_password

# Local staff HTTPS only; use scripts/start-staff-portal.ps1 and its protected certificate metadata.
# NUKHBAPAY_STAFF_SESSION_MODE=disabled
# Persistent development mode remains disabled until separately approved and provisioned.
# DB_STAFF_SESSION_ROLE=nukhabapay_session_backend
# DB_STAFF_SESSION_URL=postgresql://nukhabapay_session_backend:replace_with_percent_encoded_password@127.0.0.1:5432/nukhabapay_dev
# DB_STAFF_SESSION_EXPECTED_DATABASE_OID=<verified target database OID>
# DB_STAFF_SESSION_EXPECTED_SYSTEM_IDENTIFIER=<verified PostgreSQL system identifier>
# DB_STAFF_SESSION_POOL_MAX=2
# DB_STAFF_SESSION_CONNECTION_TIMEOUT_MS=3000
# DB_STAFF_SESSION_QUERY_TIMEOUT_MS=10000
# DB_STAFF_SESSION_STATEMENT_TIMEOUT_MS=5000
# NUKHBAPAY_STAFF_TLS_PFX_PATH=<absolute encrypted PFX path outside OneDrive>
# NUKHBAPAY_STAFF_TLS_CERT_PATH=<absolute public certificate path>
# NUKHBAPAY_STAFF_TLS_PASSPHRASE is injected process-only by the launcher; never save its value here.
